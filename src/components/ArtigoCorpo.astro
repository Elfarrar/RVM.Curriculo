---
import { render } from "astro:content";
import { tr, type Locale } from "../data/i18n";
import { listPath, readingMinutes, formatDate, type Artigo } from "../lib/artigos";

interface Props { lang: Locale; artigo: Artigo; }
const { lang, artigo } = Astro.props;
const { Content } = await render(artigo);
const { title, description, date, series } = artigo.data;
const minutos = readingMinutes(artigo.body);
---

<article class="artigo">
  <header class="artigo-head">
    {series && <p class="artigo-series mono">{series}</p>}
    <h1 class="display">{title}</h1>
    <p class="artigo-sub">{description}</p>
    <p class="artigo-meta mono">
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time> · {minutos} {tr(lang, "articles.read")}
    </p>
  </header>

  <div class="prose"><Content /></div>

  <footer class="artigo-foot">
    <a href={listPath(lang)}>{tr(lang, "articles.back")}</a>
  </footer>
</article>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>(".prose a[href^='http']").forEach((a) => {
      a.target = "_blank";
      a.rel = "noopener noreferrer";
    });
  });
</script>

<style>
  .artigo { max-width: 70ch; margin: 0 auto; padding: 9rem 1.5rem 5rem; }
  .artigo-head { margin-bottom: 2.5rem; }
  .artigo-series { font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-alt); margin: 0 0 0.75rem; }
  .artigo-head h1 { font-size: clamp(2rem, 5.5vw, 3.25rem); line-height: 1.1; margin: 0 0 1rem; }
  .artigo-sub { font-size: 1.1875rem; color: var(--color-text-muted); margin: 0 0 1rem; }
  .artigo-meta { font-size: 0.75rem; color: var(--color-text-subtle); margin: 0; }

  .prose { font-size: 1.0625rem; line-height: 1.75; }
  .prose :global(h2) { font-size: 1.5rem; line-height: 1.25; margin: 2.5rem 0 0.75rem; letter-spacing: var(--tracking-tight); }
  .prose :global(h3) { font-size: 1.1875rem; margin: 2rem 0 0.5rem; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote), .prose :global(table) { margin: 0 0 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--color-accent-hover); }
  .prose :global(blockquote) { padding-left: 1rem; border-left: 3px solid var(--color-accent-alt); color: var(--color-text-muted); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--color-accent-soft); padding: 0.1em 0.35em; border-radius: 4px; }
  .prose :global(pre) { overflow-x: auto; padding: 1rem; background: var(--color-bg-elev); border: 1px solid var(--color-border); border-radius: 0.75rem; margin: 0 0 1.25rem; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 0.9375rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border); padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--color-bg-elev); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--color-border); margin: 2.5rem 0; }

  .artigo-foot { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .artigo-foot a { color: var(--color-accent); text-decoration: none; }
  .artigo-foot a:hover { text-decoration: underline; }
</style>
