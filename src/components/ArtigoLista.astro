---
import { tr, type Locale } from "../data/i18n";
import { publicados, pathOf, slugOf, formatDate } from "../lib/artigos";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const artigos = await publicados(lang);
---

<section class="artigos">
  <header class="artigos-head">
    <h1 class="display">{tr(lang, "articles.title")}</h1>
    <p class="artigos-lead">{tr(lang, "articles.lead")}</p>
  </header>

  {artigos.length === 0 && <p class="artigos-lead">{tr(lang, "articles.empty")}</p>}

  <ul class="cards">
    {artigos.map((a) => (
      <li>
        <a class="card" href={pathOf(lang, slugOf(a))}>
          {a.data.series && <span class="card-series mono">{a.data.series}</span>}
          <h2 class="card-title">{a.data.title}</h2>
          <p class="card-desc">{a.data.description}</p>
          <time class="card-date mono" datetime={a.data.date.toISOString()}>{formatDate(a.data.date, lang)}</time>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .artigos { max-width: 760px; margin: 0 auto; padding: 9rem 1.5rem 5rem; }
  .artigos-head { margin-bottom: 2.5rem; }
  .artigos-head h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin: 0 0 0.5rem; }
  .artigos-lead { color: var(--color-text-muted); margin: 0; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .card {
    display: block; padding: 1.5rem; text-decoration: none; color: var(--color-text);
    background: var(--color-bg-elev); border: 1px solid var(--color-border); border-radius: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .card:hover { border-color: var(--color-accent); box-shadow: 0 8px 28px var(--color-accent-glow); }
  .card-series { display: block; font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-alt); margin-bottom: 0.5rem; }
  .card-title { font-size: 1.375rem; line-height: 1.25; margin: 0 0 0.5rem; letter-spacing: var(--tracking-tight); }
  .card-desc { color: var(--color-text-muted); margin: 0 0 1rem; }
  .card-date { font-size: 0.75rem; color: var(--color-text-subtle); }
</style>
