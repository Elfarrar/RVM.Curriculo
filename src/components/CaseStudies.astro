---
import { tr, type Locale } from "../data/i18n";
import { cv } from "../data/cv";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const data = cv(lang);
const isPt = lang === "pt";
---

<section id="cases" class="cases">
  <header class="cases-header reveal">
    <span class="tag mono">/ {isPt ? "estudos de caso" : "case studies"}</span>
    <h2 class="cases-title display">
      {isPt ? "Três problemas" : "Three problems"}<br/>
      <span class="mix-italic">{isPt ? "que valeram a carreira." : "that shaped the career."}</span>
    </h2>
    <p class="cases-lead">
      {isPt
        ? "Currículo lista o que a pessoa fez. Estas três histórias explicam como — e o que estava em jogo quando deu certo."
        : "A résumé lists what someone did. These three stories explain how — and what was at stake when it worked."}
    </p>
    <a href={isPt ? "/portfolio/" : "/en/portfolio/"} class="cases-portfolio mono">{tr(lang, "portfolio.home")}</a>
  </header>

  <div class="cases-tabs reveal" role="tablist" hidden aria-label={isPt ? "Estudos de caso" : "Case studies"}>
    {data.caseStudies.map((c, i) => (
      <button
        type="button"
        role="tab"
        id={`case-tab-${i}`}
        aria-controls={`case-${i}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        class="case-tab"
      >
        <span class="case-tab-top mono">
          <span class="case-tab-idx">/{String(i + 1).padStart(2, "0")}</span>
          <span class="case-tab-tag">{c.tag}</span>
        </span>
        <span class="case-tab-num display">{c.metric.n}</span>
        <span class="case-tab-label">{c.metric.l}</span>
      </button>
    ))}
  </div>

  <div class="cases-list">
    {data.caseStudies.map((c, i) => (
      <article class="case reveal" id={`case-${i}`} role="tabpanel" aria-labelledby={`case-tab-${i}`}>
        <header class="case-head">
          <span class="case-tag mono">/{String(i + 1).padStart(2, "0")} · {c.tag}</span>
          <h3 class="case-title display">{c.title}</h3>
          <p class="case-lead">{c.lead}</p>
        </header>

        <div class="case-blocks">
          {c.blocks.map((b, j) => (
            <div class="case-block">
              <h4 class="case-h mono"><span>{String(j + 1).padStart(2, "0")}</span> {b.h}</h4>
              <p class="case-p">{b.p}</p>
            </div>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  // Sem JS as abas ficam escondidas e os tres casos empilhados; com JS vira abas (um caso aberto por vez).
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".case-tab")];
  const show = (i: number, focus = false) => {
    tabs.forEach((t, k) => {
      const on = k === i;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => show(i));
    t.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show((i + 1) % tabs.length, true);
      if (e.key === "ArrowLeft") show((i - 1 + tabs.length) % tabs.length, true);
    });
  });
  if (tabs.length) {
    tabs[0].parentElement!.hidden = false;
    show(0);
  }
</script>

<style>
  .cases-portfolio { display: inline-block; margin-top: 1rem; font-size: 0.8125rem; color: var(--color-accent); text-decoration: none; }
  .cases-portfolio:hover { text-decoration: underline; }
  .cases {
    max-width: 1200px;
    margin: 9rem auto 0;
    padding: 0 1.5rem;
  }

  .cases-header { max-width: 760px; margin-bottom: 4rem; }

  .cases-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.0;
    margin: 1.25rem 0 1.5rem;
  }

  .cases-lead {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin: 0;
    max-width: 620px;
  }

  .cases-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .case-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    text-align: left;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    cursor: pointer;
    transition: border-color 0.3s, box-shadow 0.4s, background 0.3s;
  }
  .case-tab:hover { border-color: var(--color-border-strong); }
  .case-tab[aria-selected="true"] {
    border-color: var(--color-accent-alt);
    box-shadow: 0 10px 40px var(--color-accent-soft);
  }
  .case-tab-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .case-tab-idx { color: var(--color-accent-alt); }
  .case-tab-num { font-size: 2.25rem; line-height: 1; }
  .case-tab[aria-selected="true"] .case-tab-num { color: var(--color-accent-alt); }
  .case-tab-label { font-size: 0.875rem; color: var(--color-text-muted); }

  .cases-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case {
    border-radius: 22px;
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .case[hidden], .cases-tabs[hidden] { display: none; }

  .case-head { padding: 2.75rem 3rem 2.25rem; }

  .case-tag {
    display: inline-block;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 0.875rem;
  }

  .case-title {
    font-size: clamp(1.5rem, 3vw, 2.375rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    max-width: 26ch;
  }

  .case-lead {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0;
    max-width: 68ch;
  }

  .case-blocks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
  }
  .case-block { padding: 2rem 2.25rem 2.5rem; }
  .case-block + .case-block { border-left: 1px solid var(--color-border); }

  .case-h {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.875rem;
    font-weight: 500;
  }
  .case-h span { color: var(--color-accent-alt); }

  .case-p {
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 980px) {
    .case-blocks { grid-template-columns: 1fr; }
    .case-block + .case-block { border-left: 0; border-top: 1px solid var(--color-border); }
  }

  @media (max-width: 768px) {
    .cases-tabs { grid-template-columns: 1fr; gap: 0.625rem; }
    .case-tab { padding: 1rem 1.25rem; }
    .case-tab-num { font-size: 1.75rem; }
    .case-head { padding: 2rem 1.5rem 1.5rem; }
    .case-block { padding: 1.5rem; }
  }
</style>
