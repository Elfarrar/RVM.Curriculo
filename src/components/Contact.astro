---
import { tr, type Locale } from "../data/i18n";
interface Props { lang: Locale; }
const { lang } = Astro.props;
const isPt = lang === "pt";

const channels = [
  {
    label: "Email",
    value: "rvenerosomorici@gmail.com",
    href: "mailto:rvenerosomorici@gmail.com",
    icon: "M2 5l8 5 8-5M2 5h16v10H2z",
  },
  {
    label: "LinkedIn",
    value: "rafael-veneroso-morici",
    href: "https://linkedin.com/in/rafael-veneroso-morici",
    icon: "M3 3h4v14H3V3zm5.5 0h4v2h.1c.6-1.1 2-2.3 4-2.3 4.3 0 5.1 2.8 5.1 6.4V17h-4v-7c0-1.7 0-3.8-2.3-3.8-2.3 0-2.7 1.8-2.7 3.7V17h-4V3zM5 1.5a2 2 0 110 4 2 2 0 010-4z",
  },
  {
    label: "GitHub",
    value: "Elfarrar",
    href: "https://github.com/Elfarrar",
    icon: "M12 0C5.4 0 0 5.4 0 12c0 5.3 3.4 9.8 8.2 11.4.6.1.8-.3.8-.6v-2C5.7 21.5 5 19.4 5 19.4c-.5-1.4-1.3-1.8-1.3-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.4-1.3-5.4-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2.9-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6C20.6 21.7 24 17.3 24 12c0-6.6-5.4-12-12-12z",
  },
];
---

<section id="contact" class="contact">
  <div class="contact-copy">
    <span class="tag tag-dot">{tr(lang, "hero.label")}</span>
    <h2 class="contact-title display">
      {isPt ? "Vamos" : "Let's"} <span class="mix-italic">{isPt ? "conversar?" : "talk?"}</span>
    </h2>
    <p class="contact-sub">
      {isPt
        ? "Aberto a oportunidades remotas com .NET. Resposta em até 24h."
        : "Open to remote .NET opportunities. Reply within 24h."}
    </p>
  </div>

  <div class="contact-channels">
    {channels.map((c) => (
      <a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined} class="channel" data-magnetic data-magnetic-strength="0.15">
        <div class="channel-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d={c.icon} stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="channel-text">
          <span class="channel-label mono">{c.label}</span>
          <span class="channel-value">{c.value}</span>
        </div>
        <span class="channel-arrow" aria-hidden="true">&nearr;</span>
      </a>
    ))}
  </div>

  <div class="contact-pdf">
    <div>
      <h3 class="pdf-title display">{isPt ? "Prefere o PDF?" : "Prefer the PDF?"}</h3>
      <p class="pdf-sub">
        {isPt
          ? "Versão de uma página, formatada para triagem automática (ATS)."
          : "One-page version, formatted for applicant tracking systems (ATS)."}
      </p>
    </div>
    <div class="pdf-actions">
      <a href={isPt ? "/cv/Rafael-Veneroso-Morici-Curriculo.pdf" : "/cv/Rafael-Veneroso-Morici-Resume.pdf"} download class="btn btn-primary">
        <span>{isPt ? "PDF (PT-BR)" : "PDF (English)"}</span>
      </a>
      <a href={isPt ? "/cv/Rafael-Veneroso-Morici-Resume.pdf" : "/cv/Rafael-Veneroso-Morici-Curriculo.pdf"} download class="btn btn-ghost">
        <span>{isPt ? "English version" : "Versão em português"}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    max-width: 1000px;
    margin: 9rem auto 4rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .contact-title {
    font-size: clamp(2.75rem, 8vw, 6rem);
    line-height: 1;
    margin: 1.5rem 0 1.25rem;
  }

  .contact-sub {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    margin: 0 auto 3rem;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
    text-align: left;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    padding: 1.125rem;
    border-radius: 16px;
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.3s, transform 0.5s var(--ease-out-expo);
  }
  .channel:hover { border-color: var(--color-accent); }

  .channel-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .channel-text { display: flex; flex-direction: column; gap: 0.125rem; flex: 1; min-width: 0; }
  .channel-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .channel-value {
    font-size: 0.875rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .channel-arrow {
    color: var(--color-text-subtle);
    transition: transform 0.4s var(--ease-out-expo), color 0.3s;
  }
  .channel:hover .channel-arrow {
    transform: translate(4px, -4px);
    color: var(--color-accent);
  }

  .contact-pdf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 0.875rem;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .pdf-title { font-size: 1.5rem; margin: 0 0 0.375rem; }
  .pdf-sub { color: var(--color-text-muted); font-size: 0.9375rem; margin: 0; }
  .pdf-actions { display: flex; gap: 0.625rem; flex-wrap: wrap; flex-shrink: 0; }

  @media (max-width: 900px) {
    .contact-channels { grid-template-columns: 1fr; }
    .contact-pdf { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
  }
</style>
