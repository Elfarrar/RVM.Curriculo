---
import { type Locale } from "../data/i18n";
import { cv } from "../data/cv";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const data = cv(lang);
const isPt = lang === "pt";

const pdf = isPt ? "/cv/Rafael-Veneroso-Morici-Curriculo.pdf" : "/cv/Rafael-Veneroso-Morici-Resume.pdf";
---

<section id="credentials" class="cred">
  <header class="cred-header reveal">
    <span class="tag mono">/ {isPt ? "credenciais" : "credentials"}</span>
    <h2 class="cred-title display">
      {isPt ? "Formação," : "Education,"}<br/>
      <span class="mix-italic">{isPt ? "certificações e idiomas." : "certifications and languages."}</span>
    </h2>
  </header>

  <div class="cred-grid">
    <div class="cred-col reveal">
      <h3 class="cred-h mono">/ {isPt ? "formação" : "education"}</h3>
      <div class="cred-item">
        <div class="cred-name">{data.education.degree}</div>
        <div class="cred-meta">{data.education.school} · {data.education.place}</div>
        <div class="cred-year mono">{data.education.year}</div>
      </div>
    </div>

    <div class="cred-col reveal">
      <h3 class="cred-h mono">/ {isPt ? "certificações" : "certifications"}</h3>
      {data.certifications.map((c) => (
        <div class="cred-item">
          <div class="cred-name">{c.name}</div>
          <div class="cred-meta">{c.issuer}</div>
          <div class="cred-year mono">{c.status}</div>
        </div>
      ))}
    </div>

    <div class="cred-col reveal">
      <h3 class="cred-h mono">/ {isPt ? "idiomas" : "languages"}</h3>
      {data.languages.map((l) => (
        <div class="cred-item">
          <div class="cred-name">{l.name}</div>
          <div class="cred-meta">{l.level}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="cred-download reveal">
    <div class="cred-dl-copy">
      <h3 class="cred-dl-title display">{isPt ? "Prefere o PDF?" : "Prefer the PDF?"}</h3>
      <p class="cred-dl-sub">
        {isPt
          ? "Versão de duas páginas, formatada para triagem automática (ATS)."
          : "Two-page version, formatted for applicant tracking systems (ATS)."}
      </p>
    </div>
    <div class="cred-dl-actions">
      <a href={pdf} download class="btn btn-primary" data-magnetic>
        <span>{isPt ? "Baixar PDF (PT-BR)" : "Download PDF (EN)"}</span>
      </a>
      <a
        href={isPt ? "/cv/Rafael-Veneroso-Morici-Resume.pdf" : "/cv/Rafael-Veneroso-Morici-Curriculo.pdf"}
        download
        class="btn btn-ghost"
        data-magnetic
        data-magnetic-strength="0.25"
      >
        <span>{isPt ? "English version" : "Versão em português"}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cred {
    max-width: 1200px;
    margin: 9rem auto 0;
    padding: 0 1.5rem;
  }

  .cred-header { max-width: 720px; margin-bottom: 3rem; }

  .cred-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.0;
    margin: 1.25rem 0 0;
  }

  .cred-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .cred-h {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-weight: 500;
  }

  .cred-item { margin-bottom: 1.5rem; }
  .cred-item:last-child { margin-bottom: 0; }

  .cred-name {
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 0.25rem;
  }

  .cred-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .cred-year {
    color: var(--color-text-subtle);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    margin-top: 0.25rem;
  }

  .cred-download {
    margin-top: 4rem;
    padding: 2rem 2.25rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background: var(--color-bg-glass);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid var(--color-border);
  }

  .cred-dl-title {
    font-size: 1.5rem;
    margin: 0 0 0.375rem;
  }

  .cred-dl-sub {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }

  .cred-dl-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .cred-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
