---
import { tr, type Locale } from "../data/i18n";
import { cv } from "../data/cv";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const data = cv(lang);
---

<section id="experience" class="exp">
  <header class="exp-header reveal">
    <span class="tag mono">/ {tr(lang, "nav.experience").toLowerCase()}</span>
    <h2 class="exp-title display">
      {lang === "pt" ? "Experiência sólida na stack." : "Solid experience on the stack."}<br/>
      <span class="mix-italic">{lang === "pt" ? "Qualquer que seja o desafio." : "Whatever the challenge."}</span>
    </h2>
  </header>

  <ol class="exp-list">
    {data.experiences.map((e) => (
      <li class="exp-item reveal">
        <div class="exp-aside">
          <div class="exp-period mono">{e.period}</div>
          <div class="exp-location mono">{e.location}</div>
        </div>

        <div class="exp-content">
          <h3 class="exp-role">{e.role}</h3>
          <div class="exp-company">
            <strong>{e.company}</strong>
            <span class="exp-client mono"> · {e.client}</span>
          </div>

          <p class="exp-context">{e.context}</p>

          <ul class="exp-bullets">
            {e.bullets.map((b) => (
              <li><span class="exp-dot" aria-hidden="true"></span><span>{b}</span></li>
            ))}
          </ul>

          <ul class="exp-stack" aria-label="stack">
            {e.stack.map((s) => <li class="exp-chip mono">{s}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <p class="exp-prior reveal mono">{data.priorNote}</p>
</section>

<style>
  .exp {
    max-width: 1200px;
    margin: 8rem auto 0;
    padding: 0 1.5rem;
  }

  .exp-header { max-width: 720px; margin-bottom: 3rem; }

  .exp-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.0;
    margin: 1.25rem 0 0;
  }

  .exp-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding: 2.25rem 0 2.25rem 2rem;
    position: relative;
    border-left: 2px solid oklch(52% 0.16 245 / 0.22);
  }

  .exp-item::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 2.75rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .exp-aside {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.25rem;
  }

  .exp-period {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .exp-location {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    line-height: 1.5;
  }

  .exp-role {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
  }

  .exp-company {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1rem;
  }

  .exp-company strong { color: var(--color-text); font-weight: 600; }

  .exp-client {
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .exp-context {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--color-border-strong);
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .exp-bullets li {
    display: flex;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .exp-dot {
    flex: none;
    width: 5px;
    height: 5px;
    margin-top: 0.6rem;
    border-radius: 50%;
    background: var(--color-text-subtle);
  }

  .exp-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .exp-chip {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.625rem;
    border: 1px solid oklch(38% 0.155 320 / 0.16);
    border-radius: 999px;
    color: var(--color-accent);
    background: oklch(38% 0.155 320 / 0.06);
  }

  .exp-prior {
    margin: 2rem 0 0 2rem;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .exp-item { grid-template-columns: 1fr; gap: 0.75rem; padding-left: 1.25rem; }
    .exp-aside { flex-direction: row; gap: 0.75rem; align-items: baseline; }
    .exp-prior { margin-left: 1.25rem; }
  }
</style>
