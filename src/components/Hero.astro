---
import { tr, type Locale } from "../data/i18n";
import { cv } from "../data/cv";
interface Props { lang: Locale; }
const { lang } = Astro.props;
const isPt = lang === "pt";
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="tag tag-dot">{tr(lang, "hero.label")}</span>

      <h1 class="hero-title">
        <span data-split>Rafael</span>
        <br/>
        <span class="mix-italic" data-split>{isPt ? "Veneroso Morici." : "Veneroso Morici."}</span>
      </h1>

      <p class="hero-role mono">
        / {cv(lang).role} / <span class="nowrap">{cv(lang).tagline}</span>
      </p>

      <p class="hero-sub">{tr(lang, "hero.desc")}</p>

      <div class="hero-cta">
        <a
          href={isPt ? "/cv/Rafael-Veneroso-Morici-Curriculo.pdf" : "/cv/Rafael-Veneroso-Morici-Resume.pdf"}
          download
          class="btn btn-primary"
          data-magnetic
        >
          <span>{tr(lang, "hero.btn.cv")}</span>
        </a>
        <a href="https://github.com/Elfarrar" target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic data-magnetic-strength="0.25">
          <span>GitHub &nearr;</span>
        </a>
        <a href="https://linkedin.com/in/rafael-veneroso-morici" target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic data-magnetic-strength="0.25">
          <span>LinkedIn &nearr;</span>
        </a>
      </div>

      <div class="hero-meta">
        <div class="meta-item">
          <span class="meta-num display">15+</span>
          <span class="meta-label mono">{isPt ? "anos em .NET" : "years on .NET"}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-num display">6</span>
          <span class="meta-label mono">{isPt ? "domínios de negócio" : "business domains"}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-num display">100%</span>
          <span class="meta-label mono">{isPt ? "remoto" : "remote"}</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <figure class="code-card" aria-label={isPt ? "Resumo do perfil escrito como código C#" : "Profile summary written as C# code"}>
        <div class="code-bar" aria-hidden="true">
          <span class="code-dots"><i></i><i></i><i></i></span>
          <span class="code-file mono">Rafael.cs</span>
        </div>
        <pre class="code-body mono"><code><span class="c-com">// {isPt ? "15+ anos entregando software" : "15+ years shipping software"}</span>
<span class="c-com">// {isPt ? "que a operação usa" : "the business runs on"}</span>
<span class="c-kw">var</span> rafael = <span class="c-kw">new</span> <span class="c-type">Engineer</span>
{"{"}
    Role = <span class="c-str">"Senior Software Engineer"</span>,
    Stack = [<span class="c-str">".NET"</span>, <span class="c-str">"C#"</span>, <span class="c-str">"Azure"</span>, <span class="c-str">"Postgres"</span>],
    Architecture = [<span class="c-str">"VSA"</span>, <span class="c-str">"DDD"</span>],
    Focus = <span class="c-str">{isPt ? '"IA aplicada"' : '"Applied AI"'}</span>,
    Remote = <span class="c-kw">true</span>,
{"};"}

<span class="c-kw">await</span> rafael.<span class="c-type">ShipAsync</span>(problem);<span class="c-cursor" aria-hidden="true"></span></code></pre>
        <figcaption class="code-badge">
          <span class="code-badge-num display">10k</span>
          <span class="code-badge-label mono">{isPt ? "contas/dia" : "accounts/day"}<br/>{isPt ? "no pico" : "at peak"}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    padding: 8rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .hero-grid {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-copy { max-width: 640px; min-width: 0; }

  .hero-title {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.0;
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
  }

  /* O nome e dividido em letras (data-split) com transform em cada uma; o gradiente
     recortado no texto nao atravessa esses filhos, entao aqui a cor e solida. */
  .hero-title .mix-italic {
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .hero-role {
    color: var(--color-accent);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    margin-bottom: 1.75rem;
  }

  .hero-role .nowrap { white-space: nowrap; }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.0625rem);
    color: var(--color-text-muted);
    max-width: 560px;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .meta-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .meta-num { font-size: 1.875rem; line-height: 1; color: var(--color-accent); }
  .meta-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .meta-divider {
    width: 1px;
    height: 28px;
    background: var(--color-border);
  }

  /* Visual: cartao de codigo (Rafael.cs) */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    min-width: 0;
  }

  .code-card {
    position: relative;
    margin: 0;
    border-radius: 18px;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 30px 80px var(--color-shadow), 0 0 120px var(--color-accent-soft);
    transform: rotate(-1.5deg);
  }

  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .code-dots { display: flex; gap: 0.4rem; }
  .code-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }
  .code-dots i:last-child { background: var(--color-accent-alt); }
  .code-file { font-size: 0.75rem; color: var(--color-text-subtle); }

  .code-body {
    margin: 0;
    padding: 1.5rem 1.5rem 2rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--color-text);
  }
  .c-kw { color: var(--color-code-keyword); }
  .c-type { color: var(--color-code-type); }
  .c-str { color: var(--color-code-string); }
  .c-com { color: var(--color-code-comment); }
  .c-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.3em;
    vertical-align: text-bottom;
    background: var(--color-accent-alt);
    animation: pulse 1.2s steps(2) infinite;
  }

  .code-badge {
    position: absolute;
    left: -1.25rem;
    bottom: -1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    border-radius: 14px;
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 12px 30px var(--color-shadow);
  }
  .code-badge-num { font-size: 1.75rem; color: var(--color-accent-alt); }
  .code-badge-label {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 3rem; }
    .hero-visual { margin: 0 0 1.5rem; }
    .code-card { transform: none; }
    .code-body { font-size: 0.75rem; padding: 1.25rem 1.25rem 2rem; }
    .code-badge { left: auto; right: 1rem; }
  }
</style>
