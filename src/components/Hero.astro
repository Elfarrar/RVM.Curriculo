---
import { tr, type Locale } from "../data/i18n";
interface Props { lang: Locale; }
const { lang } = Astro.props;
const isPt = lang === "pt";
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="tag tag-dot">{tr(lang, "hero.label")}</span>

      <h1 class="hero-title">
        <span data-split>Rafael</span>
        <br/>
        <span class="mix-italic" data-split>{isPt ? "Veneroso Morici." : "Veneroso Morici."}</span>
      </h1>

      <p class="hero-role mono">
        {isPt ? "/ desenvolvedor sênior / .NET / 15+ anos" : "/ senior software engineer / .NET / 15+ years"}
      </p>

      <p class="hero-sub">{tr(lang, "hero.desc")}</p>

      <div class="hero-cta">
        <a
          href={isPt ? "/cv/Rafael-Veneroso-Morici-Curriculo.pdf" : "/cv/Rafael-Veneroso-Morici-Resume.pdf"}
          download
          class="btn btn-primary"
          data-magnetic
        >
          <span>{tr(lang, "hero.btn.cv")}</span>
        </a>
        <a href="https://github.com/Elfarrar" target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic data-magnetic-strength="0.25">
          <span>GitHub &nearr;</span>
        </a>
        <a href="https://linkedin.com/in/rafael-veneroso-morici" target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic data-magnetic-strength="0.25">
          <span>LinkedIn &nearr;</span>
        </a>
      </div>

      <div class="hero-meta">
        <div class="meta-item">
          <span class="meta-num display">15+</span>
          <span class="meta-label mono">{isPt ? "anos em .NET" : "years on .NET"}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-num display">5</span>
          <span class="meta-label mono">{isPt ? "domínios de negócio" : "business domains"}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-num display">100%</span>
          <span class="meta-label mono">{isPt ? "remoto" : "remote"}</span>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="card card-1 note-backend">
        <span class="card-num mono">/01</span>
        <div class="card-title display">.NET Core</div>
        <div class="card-tag mono">backend</div>
      </div>
      <div class="card card-2 note-data">
        <span class="card-num mono">/02</span>
        <div class="card-title display">Postgres</div>
        <div class="card-tag mono">data</div>
      </div>
      <div class="card card-3 note-ui">
        <span class="card-num mono">/03</span>
        <div class="card-title display">Blazor</div>
        <div class="card-tag mono">ui</div>
      </div>
      <div class="card card-4 note-infra">
        <span class="card-num mono">/04</span>
        <div class="card-title display">Docker</div>
        <div class="card-tag mono">infra</div>
      </div>
      <div class="card card-5 note-ai">
        <span class="card-num mono">/05</span>
        <div class="card-title display">Claude Code</div>
        <div class="card-tag mono">{isPt ? "ia" : "ai"}</div>
      </div>
      <div class="card card-6 note-ai">
        <span class="card-num mono">/06</span>
        <div class="card-title display">MCP</div>
        <div class="card-tag mono">{isPt ? "ia" : "ai"}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    padding: 8rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .hero-grid {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-copy { max-width: 640px; }

  .hero-title {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.0;
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
  }

  .hero-role {
    color: var(--color-accent);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    margin-bottom: 1.75rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.0625rem);
    color: var(--color-text-muted);
    max-width: 560px;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .meta-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .meta-num { font-size: 1.875rem; line-height: 1; color: var(--color-accent); }
  .meta-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .meta-divider {
    width: 1px;
    height: 28px;
    background: var(--color-border);
  }

  /* Visual: floating tech cards */
  .hero-visual {
    position: relative;
    aspect-ratio: 6 / 7;
    width: 100%;
    max-width: 480px;
    min-height: 540px;
    margin-left: auto;
  }

  .card {
    --rot: 0deg;
    position: absolute;
    width: 178px;
    padding: 1.125rem;
    border-radius: 4px 4px 14px 4px;
    background: var(--note-bg);
    border: 1px solid var(--note-ink);
    border-color: color-mix(in oklch, var(--note-ink) 22%, transparent);
    box-shadow: 0 14px 32px oklch(30% 0.03 285 / 0.14);
    transform: rotate(var(--rot));
    animation: float-note 9s ease-in-out infinite;
  }

  .note-backend { --note-bg: var(--color-note-backend); --note-ink: var(--color-note-backend-ink); }
  .note-data    { --note-bg: var(--color-note-data);    --note-ink: var(--color-note-data-ink); }
  .note-ui      { --note-bg: var(--color-note-ui);      --note-ink: var(--color-note-ui-ink); }
  .note-infra   { --note-bg: var(--color-note-infra);   --note-ink: var(--color-note-infra-ink); }
  .note-ai      { --note-bg: var(--color-note-ai);      --note-ink: var(--color-note-ai-ink); }

  /* Preserva a rotacao do post-it durante o float */
  @keyframes float-note {
    0%, 100% { transform: translate(0, 0) rotate(var(--rot)); }
    33% { transform: translate(10px, -16px) rotate(calc(var(--rot) + 1.5deg)); }
    66% { transform: translate(-8px, 11px) rotate(calc(var(--rot) - 1.5deg)); }
  }

  .card-num {
    font-size: 0.6875rem;
    color: var(--note-ink);
    letter-spacing: 0.1em;
  }

  .card-title {
    font-size: 1.5rem;
    margin: 0.5rem 0 0.25rem;
    font-weight: 600;
  }

  .card-tag {
    font-size: 0.6875rem;
    color: var(--note-ink);
    opacity: 0.8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-1 { top: 0;   left: 4%;  --rot: -6deg; animation-delay: 0s; }
  .card-2 { top: 7%;  right: 1%; --rot: 5deg;  animation-delay: -1.5s; }
  .card-3 { top: 35%; left: 0;   --rot: 3deg;  animation-delay: -3s; }
  .card-4 { top: 41%; right: 5%; --rot: -4deg; animation-delay: -4.5s; }
  .card-5 { top: 69%; left: 7%;  --rot: -3deg; animation-delay: -6s; }
  .card-6 { top: 75%; right: 0;  --rot: 6deg;  animation-delay: -7.5s; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 3rem; }
    .hero-visual { max-width: 340px; margin: 0 auto; min-height: 400px; }
    .card { width: 142px; padding: 0.875rem; }
    .card-title { font-size: 1.25rem; }
  }
</style>
