---
import { tr, type Locale } from "../data/i18n";
import { projetos, portfolioPath } from "../data/portfolio";

interface Props { lang: Locale; }
const { lang } = Astro.props;
---

<section class="portfolio">
  <header class="portfolio-head">
    <h1 class="display">{tr(lang, "portfolio.title")}</h1>
    <p class="portfolio-lead">{tr(lang, "portfolio.lead")}</p>
  </header>

  <ul class="cards">
    {projetos.map((p) => (
      <li>
        <a class="card" href={portfolioPath(lang, p.slug)}>
          <img src={p.imagem} alt={p.alt[lang]} width="1280" height="860" loading="lazy" />
          <h2 class="card-title">{p.nome}</h2>
          <p class="card-desc">{p.resumo[lang]}</p>
          <span class="card-link mono">{tr(lang, "portfolio.see")} →</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .portfolio { max-width: 760px; margin: 0 auto; padding: 9rem 1.5rem 5rem; }
  .portfolio-head { margin-bottom: 2.5rem; }
  .portfolio-head h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin: 0 0 0.5rem; }
  .portfolio-lead { color: var(--color-text-muted); margin: 0; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .card {
    display: block; padding: 1.5rem; text-decoration: none; color: var(--color-text);
    background: var(--color-bg-elev); border: 1px solid var(--color-border); border-radius: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .card:hover { border-color: var(--color-accent); box-shadow: 0 8px 28px var(--color-accent-glow); }
  .card img { display: block; width: 100%; height: auto; border-radius: 0.5rem; margin-bottom: 1.25rem; }
  .card-title { font-size: 1.375rem; line-height: 1.25; margin: 0 0 0.5rem; letter-spacing: var(--tracking-tight); }
  .card-desc { color: var(--color-text-muted); margin: 0 0 1rem; }
  .card-link { font-size: 0.8125rem; color: var(--color-accent); }
</style>
